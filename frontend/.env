# API transport: `mock` (in-browser demo backend implementing LLD §4) or `live` (Express backend).
# Switch to `live` once the backend is running; requests go to REACT_APP_API_BASE_URL.
REACT_APP_API_MODE=mock
REACT_APP_API_BASE_URL=/api/v1

# html5-qrcode ships broken source maps; this skips loading third-party maps.
# Development builds still have source maps for app code.
GENERATE_SOURCEMAP=false
