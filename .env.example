# Copy to .env (optional for local dev — docker-compose.yml has dev defaults).
# Every variable from LLD §1.3, plus Group 2 additions. Values below are dev defaults.

NODE_ENV=development
PORT=4000
# Set by docker-compose.yml for the backend container; needed only when running outside Compose.
# DATABASE_URL=postgres://soms:soms@localhost:5433/soms
# TEST_DATABASE_URL=postgres://soms:soms@localhost:5433/soms_test
DATABASE_POOL_MAX=20
# Required in production: random, at least 32 characters.
SESSION_SECRET=dev-only-session-secret-change-me
CORS_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_BYTES=5242880
# ASM-13 hold for unpaid bookings/orders.
RESERVATION_HOLD_MINUTES=15
AUTOPAY_PENDING_TIMEOUT_HOURS=24
# OD-01 (default, not approved): BEST_OF | STACK.
PRICING_COMBINATION_MODE=BEST_OF
DEFAULT_LOW_STOCK_THRESHOLD=5
# LLD §2.9 — value needs team validation.
FUNDRAISER_AT_RISK_TOLERANCE_PCT=20
# mock | unconfigured
COLLEGE_VERIFICATION_MODE=mock
VERIFICATION_HASH_KEY=dev-only-verification-key
# dev | unconfigured
NOTIFY_MODE=dev
# EMAIL | WHATSAPP to force dev delivery failures; empty = none.
DEV_NOTIFY_FAIL_CHANNEL=
# SUCCEEDED | FAILED | PENDING
SIM_AUTOPAY_OUTCOME=SUCCEEDED
# Ignored when NODE_ENV=production.
DEV_TOOLS_ENABLED=true
# No seed data exists yet (seeds need Group 1 tables); reserved for T-93.
SEED_ON_START=false
JOBS_ENABLED=true
RATE_LIMIT_ENABLED=true
LOG_LEVEL=info

# Group 2 additions -----------------------------------------------------------
# TODO(group1): delete when Group 1 merges.
# migrations = run every migration (Group 1's 002/003/006/007 included) — production default
# fixture    = apply backend/tests/fixtures/group1_schema.sql instead (tests, dev Compose)
# external   = skip Group 1 migrations; their tables already exist
GROUP1_SCHEMA=fixture
# Host ports
DB_PORT=5433
BACKEND_PORT=4000
