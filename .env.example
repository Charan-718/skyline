NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://soms:soms@localhost:5432/soms
TEST_DATABASE_URL=postgres://soms:soms@localhost:5432/soms_test
SESSION_SECRET=change-me-in-production-use-64-random-chars-minimum-for-security
# CRA dev server (frontend npm start) uses port 3000
# CRA dev server (npm start) uses port 3000; Vite or other UIs may use 5173
CORS_ORIGIN=http://localhost:3000
APP_TIMEZONE=Asia/Kolkata
# Local dev: relative to backend cwd. Docker Compose sets /app/uploads.
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880
RESERVATION_HOLD_MINUTES=15
AUTOPAY_PENDING_TIMEOUT_HOURS=24
PRICING_COMBINATION_MODE=BEST_OF
# mock = JSON fixture; database = college_student_roster table (npm run seed)
COLLEGE_VERIFICATION_MODE=database
# Must include the college domain used by seeds and login (`@skyline.ac.in`)
COLLEGE_EMAIL_DOMAINS=skyline.ac.in
VERIFICATION_HASH_KEY=dev-verification-hmac-key-change-in-prod
NOTIFY_MODE=dev
DEV_NOTIFY_FAIL_CHANNEL=
SIM_AUTOPAY_OUTCOME=SUCCEEDED
DEV_TOOLS_ENABLED=true
SEED_ON_START=false
JOBS_ENABLED=true

# --- Notifications (membership-expiry reminders) -------------------------------------------
# NOTIFY_MODE: dev (log only, nothing leaves the machine) | unconfigured | smtp (real email)
APP_BASE_URL=http://localhost:3000
# SMTP mailbox. Gmail (free, no domain): enable 2-Step Verification, create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=koushikthummu@gmail.com
SMTP_PASS=jvyd tcbb botn psps
SMTP_FROM_EMAIL=koushikthummu@gmail.com
SMTP_FROM_NAME=SOMS
# Demo members for the reminder (npx knex seed:run): one with autopay off, one with autopay on
DEMO_MEMBER_EMAIL=
DEMO_AUTOPAY_MEMBER_EMAIL=
