# Environment template for backend service
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://soms:soms@localhost:5432/soms
TEST_DATABASE_URL=postgres://soms:soms@localhost:5432/soms_test
SESSION_SECRET=change-me-in-production-use-64-random-chars-minimum-for-security
CORS_ORIGIN=http://localhost:3000
APP_TIMEZONE=Asia/Kolkata
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880
RESERVATION_HOLD_MINUTES=15
AUTOPAY_PENDING_TIMEOUT_HOURS=24
PRICING_COMBINATION_MODE=BEST_OF
COLLEGE_VERIFICATION_MODE=database
COLLEGE_EMAIL_DOMAINS=skyline.ac.in
VERIFICATION_HASH_KEY=dev-verification-hmac-key-change-in-prod
NOTIFY_MODE=dev
DEV_NOTIFY_FAIL_CHANNEL=
SIM_AUTOPAY_OUTCOME=SUCCEEDED
DEV_TOOLS_ENABLED=true
SEED_ON_START=false
JOBS_ENABLED=true

# --- Notifications ---------------------------------------------------------
APP_BASE_URL=http://localhost:3000
DEMO_MEMBER_EMAIL=
DEMO_AUTOPAY_MEMBER_EMAIL=

# --- Event Assistant (Google Gemini) ---------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
ASSISTANT_RATE_LIMIT_PER_MIN=10

# --- Event Draft Agent -----------------------------------------------------
EVENT_AGENT_GEMINI_API_KEY=
EVENT_AGENT_GEMINI_MODEL=gemini-3.8-flash
EVENT_AGENT_TIMEOUT_MS=60000
EVENT_AGENT_FALLBACK_MODEL=gemini-3.5-flash-lite
EVENT_AGENT_FALLBACK_TIMEOUT_MS=20000
OPENROUTER_API_KEY=your_openrouter_api_key_here
EVENT_AGENT_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
EVENT_AGENT_OPENROUTER_TIMEOUT_MS=30000
EVENT_AGENT_CHAIN=gemini,openrouter,gemini-fallback
EVENT_AGENT_RATE_LIMIT_PER_MIN=15
